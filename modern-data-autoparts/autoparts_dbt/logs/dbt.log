  create  table "autoparts_dwh"."analytics"."dim_parts__dbt_tmp"
  
  
    as
  
  (
    

with stg_parts as (
    select * from "autoparts_dwh"."analytics"."stg_parts"
),

stg_manufacturers as (
    select * from "autoparts_dwh"."analytics"."stg_manufacturers"
)

select
    p.part_id,
    p.part_name,
    p.category,
    p.price,
    p.is_active,
