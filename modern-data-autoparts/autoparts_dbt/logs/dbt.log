  create  table "autoparts_dwh"."analytics"."fct_returns__dbt_tmp"
  
  
    as
  
  (
    

with stg_returns as (
    select * from "autoparts_dwh"."analytics"."stg_returns"
),

stg_sales as (
    select * from "autoparts_dwh"."analytics"."stg_sales"
)

select
    r.return_id,
    r.sale_id,
    r.owner_id,
    r.part_id,
    r.returned_at,
    r.quantity,
    r.refund_amount,
    r.reason,
    r.comment
from stg_returns r
-- Data Integrity: повернення має відповідати існуючому продажу
join stg_sales s on r.sale_id = s.sale_id
  );
  
[0m17:15:37.859838 [debug] [Thread-2 (]: On model.autoparts_dbt.fct_sales: /* {"app": "dbt", "dbt_version": "1.8.8", "profile_name": "autoparts_dbt", "target_name": "dev", "node_id": "model.autoparts_dbt.fct_sales"} */

  
    

  create  table "autoparts_dwh"."analytics"."fct_sales__dbt_tmp"
  
  
    as
  
  (
    

with stg_sales as (
    select * from "autoparts_dwh"."analytics"."stg_sales"
),

stg_car_owners as (
    select * from "autoparts_dwh"."analytics"."stg_car_owners"
),

stg_parts as (
    select * from "autoparts_dwh"."analytics"."stg_parts"
)

select
    s.sale_id,
    s.owner_id,
    s.part_id,
    p.manufacturer_id,
    s.sold_at,
    s.quantity,
    s.unit_price,
    -- Сума продажу = кількість * ціна на момент продажу
    s.quantity * s.unit_price as total_amount,
    s.payment_method
from stg_sales s
-- Data Integrity: беремо лише продажі з існуючими власниками та запчастинами
join stg_car_owners o on s.owner_id = o.owner_id
join stg_parts p on s.part_id = p.part_id
  );
  
